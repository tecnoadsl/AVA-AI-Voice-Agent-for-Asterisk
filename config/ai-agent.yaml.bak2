config_version: 6
active_pipeline: litellm_hybrid
default_provider: litellm_hybrid
audio_transport: externalmedia
external_media:
  codec: ulaw
  direction: both
  port_range: 18080:18099
  rtp_host: 0.0.0.0
  rtp_port: 18080
downstream_mode: file
contexts:
  default:
    greeting: Buongiorno, TecnoADSL. Come posso aiutarla?
    profile: telephony_ulaw_8k
    prompt: |
      Operatore servizio clienti TecnoADSL (provider internet, Umbria, Toscana, Marche, Sardegna). Canale: voice

      SEI AUTORIZZATO SOLO A 2 ATTIVITÀ DIRETTE:
      1. Apertura segnalazione guasto/problema
      2. Verifica copertura/attivazione

      Per QUALSIASI altra richiesta: chiedi il nome, un recapito telefonico e un breve riepilogo, poi chiama forward_request con nome e riepilogo.
      - Lunedì-Venerdì feriali: "Ho inoltrato la Sua richiesta. Un operatore La contatterà a breve."
      - Weekend e festivi: "La Sua richiesta è stata salvata e inoltrata al reparto competente. Verrà ricontattato al più presto."

      REGOLE ASSOLUTE:
      - Rispondi in italiano, massimo 1-2 frasi. Dai del Lei.
      - MAI dire "mi dispiace", MAI scusarsi.
      - MAI dire "un momento", "attenda", "verifico". Rispondi subito.
      - NON ripetere quello che il cliente ha detto.
      - NON chiedere dettagli inutili.
      - NON fare domande ovvie (es. se internet è down, non chiedere se anche altri dispositivi non funzionano).

      ---

      ATTIVITÀ 1 — SEGNALAZIONE GUASTO:
      - Cliente segnala guasto/problema: chiedi nome e recapito telefonico, poi chiama open_ticket con nome, telefono e descrizione del problema.
      - Dopo open_ticket, comunica il numero ticket e saluta: "[Nome], segnalazione numero [numero] aperta. Un tecnico La ricontatterà il prima possibile. Buona giornata."

      ---

      ATTIVITÀ 2 — VERIFICA COPERTURA (flusso obbligatorio in 3 step):

      STEP 1: Chiedi solo il COMUNE. Chiama check_coverage(city). NON dire se è coperto. Rispondi SOLO: "Mi indica la via?"
      STEP 2: Il cliente dà la VIA. Chiama check_coverage(city, street). NON dire se è coperto. Rispondi SOLO: "Mi indica il numero civico?"
      STEP 3: Il cliente dà il CIVICO. Chiama check_coverage(city, street, civic). ORA puoi comunicare il risultato completo con tecnologie e velocità. Saluta.

      REGOLE COPERTURA TASSATIVE:
      - NON saltare step. NON chiedere via e civico insieme.
      - NON dire "coperta", "coperto", "disponibile" prima dello STEP 3.
      - Allo STEP 2 DEVI sempre terminare con la domanda sul civico.

      ---

      ATTIVITÀ 3 — QUALSIASI ALTRA RICHIESTA:
      - Chiedi nome, recapito telefonico e cosa serve.
      - Chiama forward_request(customer_name, request_summary).
      - Rispondi con il messaggio appropriato (feriale/festivo).
      - Saluta.

      ---

      FLUSSO GENERALE:
      1. Capire cosa serve (1 domanda max)
      2. Se segnalazione: nome + telefono → open_ticket → numero ticket → saluta
      3. Se copertura: seguire i 3 step tassativi
      4. Qualsiasi altra cosa: nome + telefono + riepilogo → forward_request → messaggio appropriato → saluta
    tools_enabled: true
    tools:
    - open_ticket
    - check_coverage
    - forward_request
    - live_agent_transfer
    - hangup_call
barge_in:
  enabled: true
  energy_threshold: 700
  initial_protection_ms: 100
  min_ms: 150
  post_tts_end_protection_ms: 100
vad:
  enhanced_enabled: true
  fallback_buffer_size: 128000
  fallback_enabled: true
  fallback_interval_ms: 4000
  max_utterance_duration_ms: 10000
  min_utterance_duration_ms: 600
  use_provider_vad: false
  utterance_padding_ms: 200
  webrtc_aggressiveness: 1
  webrtc_end_silence_frames: 50
  webrtc_start_frames: 3
streaming:
  chunk_size_ms: 20
  connection_timeout_ms: 120000
  continuous_stream: true
  empty_backoff_ticks_max: 5
  fallback_timeout_ms: 8000
  greeting_min_start_ms: 40
  jitter_buffer_ms: 950
  keepalive_interval_ms: 5000
  low_watermark_ms: 80
  min_start_ms: 120
  normalizer:
    enabled: true
    max_gain_db: 18.0
    target_rms: 1400
  provider_grace_ms: 500
  sample_rate: 8000
profiles:
  default: telephony_responsive
  telephony_ulaw_8k:
    chunk_ms: auto
    idle_cutoff_ms: 800
    internal_rate_hz: 8000
    provider_pref:
      input_encoding: mulaw
      input_sample_rate_hz: 8000
      output_encoding: mulaw
      output_sample_rate_hz: 8000
    transport_out:
      encoding: slin
      sample_rate_hz: 8000
  telephony_responsive:
    chunk_ms: auto
    idle_cutoff_ms: 600
    internal_rate_hz: 8000
    provider_pref:
      input_encoding: mulaw
      input_sample_rate_hz: 8000
      output_encoding: mulaw
      output_sample_rate_hz: 8000
    transport_out:
      encoding: slin
      sample_rate_hz: 8000
pipelines:
  local_hybrid:
    llm: local_llm
    options:
      llm:
        base_url: http://127.0.0.1:11434
        max_tokens: 150
        model: qwen3:30b-a3b-q4_K_M
        temperature: 0.7
      stt:
        chunk_ms: 160
        mode: stt
        stream_format: pcm16_16k
        streaming: true
      tts:
        format:
          encoding: mulaw
          sample_rate: 8000
    stt: local_stt
    tts: elevenlabs_tts
  litellm_hybrid:
    llm: litellm_llm
    options:
      llm:
        chat_base_url: http://127.0.0.1:4001/v1
        api_key: sk-tecnoadsl-master-2026
        chat_model: claude-haiku
        max_tokens: 150
        temperature: 0.3
        tools_enabled: true
      stt:
        chunk_ms: 160
        mode: stt
        stream_format: pcm16_16k
        streaming: true
      tts:
        format:
          encoding: mulaw
          sample_rate: 8000
    stt: local_stt
    tts: groq_tts
providers:
  local:
    chunk_ms: ${LOCAL_WS_CHUNK_MS:=320}
    connect_timeout_sec: ${LOCAL_WS_CONNECT_TIMEOUT:=2.0}
    enabled: true
    llm_model: models/llm/phi-3-mini-4k-instruct.Q4_K_M.gguf
    max_tokens: 32
    response_timeout_sec: ${LOCAL_WS_RESPONSE_TIMEOUT:=10.0}
    stt_model: models/stt/vosk-model-it-0.22
    temperature: 0.4
    tts_voice: models/tts/it_IT-riccardo-x_low.onnx
    ws_url: ${LOCAL_WS_URL:-ws://127.0.0.1:8765}
  local_stt:
    auth_token: ${LOCAL_WS_AUTH_TOKEN:-}
    capabilities:
    - stt
    chunk_ms: ${LOCAL_WS_CHUNK_MS:=320}
    connect_timeout_sec: ${LOCAL_WS_CONNECT_TIMEOUT:=2.0}
    enabled: false
    response_timeout_sec: ${LOCAL_WS_RESPONSE_TIMEOUT:=10.0}
    stt_backend: vosk
    stt_model: models/stt/vosk-model-en-us-0.22
    type: local
    ws_url: ${LOCAL_WS_URL:-ws://127.0.0.1:8765}
  local_tts:
    auth_token: ${LOCAL_WS_AUTH_TOKEN:-}
    capabilities:
    - tts
    enabled: false
    response_timeout_sec: ${LOCAL_WS_RESPONSE_TIMEOUT:=10.0}
    tts_voice: models/tts/en_US-lessac-medium.onnx
    type: local
    ws_url: ${LOCAL_WS_URL:-ws://127.0.0.1:8765}
  openai_llm:
    capabilities:
    - llm
    api_key: ${OPENAI_API_KEY}
    chat_base_url: https://api.openai.com/v1
    chat_model: gpt-4o-mini
    enabled: false
    response_timeout_sec: 5
    temperature: 0.7
    type: openai
  litellm_llm:
    capabilities:
    - llm
    api_key: sk-tecnoadsl-master-2026
    chat_base_url: http://127.0.0.1:4001/v1
    chat_model: claude-haiku
    enabled: true
    response_timeout_sec: 15
    temperature: 0.3
    max_tokens: 150
    type: openai
    tools_enabled: true
  groq_llm:
    capabilities:
    - llm
    api_key: ${GROQ_API_KEY}
    chat_base_url: https://api.groq.com/openai/v1
    chat_model: llama-3.3-70b-versatile
    enabled: false
    response_timeout_sec: 10
    temperature: 0.7
    tools_enabled: false
    type: openai
  groq_stt:
    capabilities:
    - stt
    type: groq
    enabled: false
    stt_base_url: https://api.groq.com/openai/v1/audio/transcriptions
    stt_model: whisper-large-v3-turbo
    response_format: json
    temperature: 0
    request_timeout_sec: 15
  groq_tts:
    capabilities:
    - tts
    type: groq
    enabled: true
    tts_base_url: http://127.0.0.1:8200/v1/audio/speech
    tts_model: mistralai/Voxtral-4B-TTS-2603
    voice: it_male
    response_format: wav
    max_input_chars: 500
    target_encoding: mulaw
    target_sample_rate_hz: 8000
    chunk_size_ms: 20
    request_timeout_sec: 30
    api_key: not-needed
  azure_stt:
    type: azure
    capabilities:
    - stt
    enabled: false
    region: eastus
    language: en-US
    variant: realtime
    request_timeout_sec: 15.0
  azure_tts:
    type: azure
    capabilities:
    - tts
    enabled: false
    region: eastus
    voice_name: en-US-JennyNeural
    output_format: riff-8khz-16bit-mono-pcm
    target_encoding: mulaw
    target_sample_rate_hz: 8000
    chunk_size_ms: 20
    request_timeout_sec: 15.0
  minimax_llm:
    capabilities:
    - llm
    chat_base_url: https://api.minimax.io/v1
    chat_model: MiniMax-M2.7
    enabled: false
    temperature: 1.0
    response_timeout_sec: 30
    type: minimax
  ollama_llm:
    capabilities:
    - llm
    base_url: http://localhost:11434
    model: llama3.2
    enabled: false
    temperature: 0.7
    max_tokens: 200
    timeout_sec: 60
    tools_enabled: true
    type: ollama
  openai_realtime:
    base_url: wss://api.openai.com/v1/realtime
    capabilities:
    - stt
    - llm
    - tts
    continuous_input: true
    egress_pacer_enabled: false
    egress_pacer_warmup_ms: 320
    enabled: false
    greeting: Hello, how can I help you today?
    input_encoding: ulaw
    input_gain_max_db: 0
    input_gain_target_rms: 0
    input_sample_rate_hz: 8000
    instructions: You are a voice assistant. Always speak your responses out loud.
    max_response_output_tokens: 4096
    api_version: beta
    model: gpt-4o-realtime-preview-2024-12-17
    organization: ''
    output_encoding: mulaw
    output_sample_rate_hz: 24000
    provider_input_encoding: linear16
    provider_input_sample_rate_hz: 24000
    response_modalities:
    - audio
    - text
    target_encoding: mulaw
    target_sample_rate_hz: 8000
    temperature: 0.6
    turn_detection:
      create_response: true
      prefix_padding_ms: 300
      silence_duration_ms: 1000
      threshold: 0.5
      type: server_vad
    type: openai_realtime
    voice: alloy
  elevenlabs_agent:
    type: full
    enabled: false
    capabilities:
    - stt
    - llm
    - tts
    input_encoding: ulaw
    input_sample_rate_hz: 8000
    provider_input_encoding: pcm16
    provider_input_sample_rate_hz: 16000
    output_encoding: pcm16
    output_sample_rate_hz: 16000
    target_encoding: ulaw
    target_sample_rate_hz: 8000
    voice_id: uDsPstFWFBUXjIBimV7s
    model_id: eleven_flash_v2_5
    voice_settings:
      stability: 0.5
      similarity_boost: 0.75
      style: 0
      use_speaker_boost: true
    greeting: Hello! I'm your ElevenLabs voice assistant. How can I help you today?
    instructions: You are a helpful voice assistant. Be concise and friendly.
    continuous_input: true
    input_gain_target_rms: 0
    input_gain_max_db: 0
  elevenlabs_tts:
    type: elevenlabs
    enabled: true
    api_key: ${ELEVENLABS_API_KEY}
    voice_id: GOAZNavLupajyL3YafaD
    model_id: eleven_flash_v2_5
    output_format: ulaw_8000
    stability: 0.5
    similarity_boost: 0.75
llm:
  initial_greeting: Buongiorno, benvenuto in TecnoADSL. Come posso aiutarla?
  prompt: Assistente telefonico TecnoADSL. Rispondi in italiano, in modo breve e cordiale. Dai del Lei. Massimo 1-2 frasi.
asterisk:
  app_name: asterisk-ai-voice-agent
audiosocket:
  format: slin
  host: 0.0.0.0
  port: 8090
tools:
  gateway_postcall:
    kind: generic_webhook
    phase: post_call
    enabled: true
    is_global: true
    timeout_ms: 5000
    url: http://172.17.0.1:8081/api/gateway/voice-call-end
    method: POST
    headers:
      Content-Type: application/json
      X-API-Key: tna_default_key_2026
    payload_template: "{\n        \"schema_version\": 1,\n        \"event_type\": \"call_completed\",\n        \"call_id\": \"{call_id}\",\n        \"caller_number\": \"{caller_number}\",\n        \"caller_name\": \"{caller_name}\",\n        \"call_duration\": {call_duration},\n        \"call_outcome\": \"{call_outcome}\",\n        \"transcript\": {transcript_json},\n        \"context\": \"{context_name}\",\n        \"pipeline\": \"{provider}\",\n        \"timestamp\": \"{call_end_time}\"\n    }"
  n8n_voice_ticket:
    kind: generic_webhook
    phase: post_call
    enabled: true
    is_global: true
    timeout_ms: 10000
    url: http://172.17.0.1:5678/webhook/voice-ticket
    method: POST
    headers:
      Content-Type: application/json
    payload_template: "{\n        \"call_id\": \"{call_id}\",\n        \"caller_number\": \"{caller_number}\",\n        \"caller_name\": \"{caller_name}\",\n        \"duration\": {call_duration},\n        \"outcome\": \"{call_outcome}\",\n        \"transcript\": {transcript_json},\n        \"context\": \"{context_name}\",\n        \"timestamp\": \"{call_end_time}\"\n    }"
in_call_tools:
  open_ticket:
    kind: in_call_http_lookup
    enabled: true
    description: Apri un ticket di segnalazione guasto per il cliente. Usa questo tool dopo aver raccolto nome e recapito telefonico del cliente.
    timeout_ms: 8000
    url: http://172.17.0.1:5678/webhook/voice-ticket
    method: POST
    headers:
      Content-Type: application/json
      x-api-key: jsC1_xwLiF1rykWThiTWy11fltIL0IrI7eWpvquHa_A
    body_template: "{\n  \"caller_number\": \"{caller_number}\",\n  \"customer_name\": \"{customer_name}\",\n  \"contact_phone\": \"{contact_phone}\",\n  \"problem_type\": \"{problem_type}\",\n  \"problem_since\": \"{problem_since}\",\n  \"customer_code\": \"{customer_code}\",\n  \"notes\": \"{notes}\"\n}\n"
    parameters:
    - name: customer_name
      type: string
      description: Nome e cognome del cliente
      required: true
    - name: problem_type
      type: string
      description: "Tipo di problema segnalato (es: internet non funziona, linea lenta, VoIP non funziona)"
      required: true
    - name: problem_since
      type: string
      description: "Da quando il cliente ha il problema (es: da ieri, da stamattina, da 3 giorni)"
      required: false
    - name: contact_phone
      type: string
      description: "Numero di telefono per ricontattare il cliente."
      required: true
    - name: customer_code
      type: string
      description: Codice cliente se fornito, altrimenti vuoto
      required: false
    - name: notes
      type: string
      description: Eventuali note aggiuntive sul problema
      required: false
    return_raw_json: true
    error_message: Non sono riuscito ad aprire la segnalazione. La passo a un operatore.
  check_coverage:
    kind: in_call_http_lookup
    enabled: true
    description: Verifica la copertura fibra/internet a un indirizzo. Chiamalo progressivamente, prima solo il comune, poi comune+via, poi comune+via+civico.
    timeout_ms: 8000
    url: https://api.dev.tecnoadsl.it/coverage-check.php
    method: POST
    headers:
      Content-Type: application/json
    body_template: "{\"address\":{\"city\":\"{city}\",\"street\":\"{street}\",\"civic\":\"{civic}\"}}"
    parameters:
    - name: city
      type: string
      description: Comune del cliente (es. Perugia, Foligno, Terni)
      required: true
    - name: street
      type: string
      description: Solo nome via senza civico (es. Via Roma). Ometti al primo step.
      required: false
    - name: civic
      type: string
      description: Numero civico (es. 15). Ometti fino al terzo step.
      required: false
    return_raw_json: true
    error_message: Non riesco a verificare la copertura al momento. La passo a un operatore.
  forward_request:
    kind: in_call_http_lookup
    enabled: true
    description: Inoltra una richiesta generica del cliente (non guasto, non copertura) al reparto competente. Usa dopo aver raccolto nome, telefono e riepilogo.
    timeout_ms: 8000
    url: http://172.17.0.1:8080/api/tickets/forward-request
    method: POST
    headers:
      Content-Type: application/json
    body_template: "{\n  \"caller_number\": \"{caller_number}\",\n  \"customer_name\": \"{customer_name}\",\n  \"contact_phone\": \"{contact_phone}\",\n  \"request_summary\": \"{request_summary}\"\n}\n"
    parameters:
    - name: customer_name
      type: string
      description: Nome e cognome del cliente
      required: true
    - name: contact_phone
      type: string
      description: Numero di telefono per ricontattare il cliente
      required: true
    - name: request_summary
      type: string
      description: Breve riepilogo della richiesta del cliente
      required: true
    return_raw_json: true
    error_message: Non sono riuscito a inoltrare la richiesta. La passo a un operatore.
